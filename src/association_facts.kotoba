(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count topic by-topic-count by-topic-id]))
(defn association-covered? [a :string] :bool (string=? a "ubf"))
(defn entry-count [a :string] :i64 (if (association-covered? a) 2 0))
(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (= i 0) true (if (= i 1) true false)) false))
(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "ubf.founding-1982")
        (string=? f "title") (option-some-of [:option :string] "UBF founding (homepage)")
        (string=? f "association") (option-some-of [:option :string] "ubf")
        (string=? f "isic") (option-some-of [:option :string] "6419")
        (string=? f "country") (option-some-of [:option :string] "ARE")
        (string=? f "kind") (option-some-of [:option :string] "governance-program")
        (string=? f "url") (option-some-of [:option :string] "https://www.ubf.ae/")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-ubf-ae")
        (string=? f "established-date") (option-some-of [:option :string] "1982")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-16")
        :else (option-none-of [:option :string]))
      (cond
        (string=? f "id") (option-some-of [:option :string] "ubf.tasharuk-platform-2017")
        (string=? f "title") (option-some-of [:option :string] "TASHARUK cyber threat intelligence sharing platform (Initiatives)")
        (string=? f "association") (option-some-of [:option :string] "ubf")
        (string=? f "isic") (option-some-of [:option :string] "6419")
        (string=? f "country") (option-some-of [:option :string] "ARE")
        (string=? f "kind") (option-some-of [:option :string] "governance-program")
        (string=? f "url") (option-some-of [:option :string] "https://ubf.ae/en/activities/initiatives/initiatives-details/3")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-ubf-ae")
        (string=? f "established-date") (option-some-of [:option :string] "2017")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-16")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn topic-count [a :string i :i64] :i64 (if (valid-entry? a i) 1 0))
(defn topic [a :string i :i64 ti :i64] [:option :string]
  (if (valid-entry? a i)
    (if (= ti 0) (if (= i 0) (option-some-of [:option :string] "governance")
                     (option-some-of [:option :string] "technology-standards"))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn by-topic-count [a :string t :string] :i64
  (if (association-covered? a)
    (if (string=? t "governance") 1 (if (string=? t "technology-standards") 1 0)) 0))
(defn by-topic-id [a :string t :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (if (string=? t "governance") (entry-field a 0 "id")
        (if (string=? t "technology-standards") (entry-field a 1 "id") (option-none-of [:option :string])))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn main [] :i64 0)
